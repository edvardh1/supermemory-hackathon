# Copy to .env.local and fill in. Never commit real values.

# Supabase (project URL + keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Anthropic (cover letters + application answers)
ANTHROPIC_API_KEY=sk-ant-xxx

# Supermemory — per-user memory that personalizes applications.
# Feature is inert if this is unset. Get a key at https://console.supermemory.ai
SUPERMEMORY_API_KEY=sm_xxx
# The API key may be scoped to a fixed container tag; override if needed.
# SUPERMEMORY_CONTAINER_TAG=job-dashboard
